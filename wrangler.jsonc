{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 🔴 YER TUTUCU — bu şablondan yeni bir eklenti türetirken DEĞİŞTİRİLİR.
  // Bu ad workers.dev alt alan adını belirler ve `package.json` name ile AYNI olmalıdır;
  // `/setup` kurulum röportajı ikisini birlikte günceller, elle tek tarafı değiştirme.
  "name": "restomenum-plugin",
  // OpenNext'in ürettiği worker YALNIZ fetch içerir; scheduled ve queue handler'ları
  // için onu saran kendi girişimizi kullanırız (worker/index.ts).
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",

  // nodejs_compat ZORUNLU — @restomenum/plugin-sdk `node:crypto` kullanıyor.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Dedup tablosunun budanması — her gece 03:00 UTC (§2.6 saklama politikası).
  "triggers": {
    "crons": ["0 3 * * *"]
  },

  // Dayanıklı olay işleme. `waitUntil` isolate ölürse işi kaybeder; kuyruk kaybetmez.
  "queues": {
    "producers": [{ "binding": "EVENT_QUEUE", "queue": "restomenum-plugin-events" }],
    "consumers": [
      {
        "queue": "restomenum-plugin-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        // Platform zaten 6 kez retry'lıyor; kuyruk tarafında 3 deneme yeterli.
        "max_retries": 3,
        "dead_letter_queue": "restomenum-plugin-events-dlq"
      }
    ]
  },


  // ───────────────────────────────────────────────────────────────────────────
  // DEPLOY: elle YAPILMAZ. GitHub'a push → Cloudflare Workers Builds yayınlar.
  // `wrangler deploy` yerelden çalıştırılmaz (CLAUDE.md §3).
  //
  // Workers Builds ayarları (panelden BİR KEZ, repo bağlanırken):
  //   Build command  : npm run build       ← next build + Worker paketi (tek komut)
  //   Deploy command : npx wrangler deploy  ← Cloudflare'in varsayılanı, değiştirmeye gerek yok
  //   Root directory : /
  //   Node sürümü    : 22
  //
  // `npm run build` = next build && opennextjs-cloudflare build --skipNextBuild
  // `--skipNextBuild` ŞART: OpenNext varsayılan olarak `npm run build` çağırır; bayrak
  // olmadan script kendini çağırır ve derleme sonsuz döngüye girer.
  //
  // Yerel doğrulama serbest:  npm run preview  ·  npx wrangler deploy --dry-run
  // ───────────────────────────────────────────────────────────────────────────

  // Secret DEĞİL, yalnız hassas olmayan ayarlar buraya yazılır.
  // RESTOMENUM_PLUGIN_ID portaldan alınır ve BURAYA yazılır (gizli değil).
  "vars": {
    "RESTOMENUM_PLUGIN_ID": "",
    "RESTOMENUM_ENVIRONMENT": "sandbox"
  }

  // Secret'lar repoya girmez, `wrangler secret put <AD>` ile yüklenir (yerelde .dev.vars):
  //   RESTOMENUM_CLIENT_SECRET  — portaldan alınan cs_...
  //   SECRET_ENCRYPTION_KEY     — base64 32 bayt:  openssl rand -base64 32
  // ⚠️ Bunlar BUILD değil RUNTIME secret'ıdır — Workers Builds ortam değişkeni olarak
  //    değil, Worker secret'ı olarak tanımlanmalı; yoksa uygulama açılışta 503 döner.

  // Veri katmanı: D1 (CLAUDE.md §6). `wrangler dev` bunu yerelde SQLite olarak açar;
  // uzak ortam için database_id Cloudflare'de oluşturulup buraya yazılır.
  ,"d1_databases": [
    {
      "binding": "DB",
      "database_name": "restomenum-plugin",  // yer tutucu — kurulumda değişir
      "database_id": "local-dev",
      "migrations_dir": "drizzle"
    }
  ]
}
